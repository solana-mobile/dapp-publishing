{
  "name": "@solana-mobile/dapp-store-publishing-tools",
  "version": "1.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "import": "./lib/index.js",
    "require": "./lib/index.js",
    "types": "./lib/types/index.d.ts"
  },
  "files": [
    "lib",
    "src",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "swc src -d lib --copy-files && pnpm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "shx mkdir -p lib && shx rm -rf lib",
    "prebuild": "pnpm run clean",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "watch": "swc src --out-dir lib -w"
  },
  "devDependencies": {
    "@jest/globals": "^29.5.0",
    "@swc/jest": "^0.2.26",
    "@types/jest": "^29.5.1",
    "jest": "^29.5.0",
    "shx": "^0.3.4"
  },
  "dependencies": {
    "@solana/kit": "^8.5.0",
    "get-video-dimensions": "^1.0.0",
    "image-size": "^1.0.2"
  }
}
